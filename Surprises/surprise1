<!DOCTYPE html>
<html>
<head>
<title>Surprise 1</title>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>

/* BASE */
body {
    margin: 0;
    font-family: Arial, sans-serif;
    overflow-x: hidden;
    transition: background 1s ease;
}

/* START SCREEN */
.start-screen {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #3a7bd5, #00d2ff);
    color: white;
    text-align: center;
}

/* BUTTON */
#revealBtn {
    margin-top: 20px;
    padding: 14px 28px;
    border: none;
    border-radius: 12px;
    background: white;
    font-size: 16px;
    cursor: pointer;
}

/* MAIN SCREEN */
.main-screen {
    background: linear-gradient(135deg, #a9c0cf, #cfe3f1);
    min-height: 100vh;
    padding-bottom: 100px;
}

/* BANNER */
.banner {
    display: none;
    margin-top: 40px;
    text-align: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
}

.letter {
    background: #ff4d6d;
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: clamp(14px, 3vw, 22px);
    animation: swing 2s infinite ease-in-out;
}

.letter:nth-child(even) {
    background: #ff85a2;
}

@keyframes swing {
    0% { transform: rotate(-8deg); }
    50% { transform: rotate(8deg); }
    100% { transform: rotate(-8deg); }
}

/* PHOTOS */
.photos {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    padding: 0 10px;
}

.polaroid {
    width: 160px;
    background: white;
    padding: 10px;
    border-radius: 10px;
    transform: rotate(-3deg);
    animation: float 4s infinite ease-in-out;
}

.polaroid:nth-child(2) {
    transform: rotate(5deg);
}

.polaroid:nth-child(3) {
    transform: rotate(-6deg);
}

.polaroid img {
    width: 100%;
    border-radius: 5px;
}

@keyframes float {
    50% { transform: translateY(-10px) rotate(2deg); }
}

/* BALLOONS */
.balloons {
    display: none;
    position: fixed;
    bottom: -100px;
    width: 100%;
    display: flex;
    justify-content: space-around;
}

.balloon {
    width: 30px;
    height: 45px;
    border-radius: 50%;
    animation: floatUp 6s infinite ease-in;
}

.balloon:nth-child(1) { background: red; }
.balloon:nth-child(2) { background: blue; animation-duration: 7s; }
.balloon:nth-child(3) { background: green; animation-duration: 5s; }

@keyframes floatUp {
    to { transform: translateY(-120vh); opacity: 0; }
}

/* BACK BUTTON (hidden initially) */
.back-btn {
    display: none;
    position: fixed;
    right: 15px;
    bottom: 15px;
    text-decoration: none;
    background: #e6c86e;
    padding: 10px 20px;
    border-radius: 20px;
    color: black;
    font-weight: bold;
}

/* MOBILE TWEAK */
@media (max-width: 600px) {
    .polaroid {
        width: 130px;
    }
}

</style>
</head>

<body class="start-screen">

<!-- START SCREEN -->
<div id="startContent">
    <h2>Tap to open your surprise 🎁</h2>
    <button id="revealBtn">Tap to Reveal</button>
</div>

<!-- MAIN CONTENT -->
<div id="mainContent" style="display:none;">

    <!-- BANNER -->
    <div class="banner" id="banner"></div>

    <!-- PHOTOS -->
    <div class="photos">
        <div class="polaroid">
            <img src="../images/photo1.jpg">
        </div>
        <div class="polaroid">
            <img src="../images/photo2.jpg">
        </div>
        <div class="polaroid">
            <img src="../images/photo6.jpg">
        </div>
    </div>

    <!-- BALLOONS -->
    <div class="balloons">
        <div class="balloon"></div>
        <div class="balloon"></div>
        <div class="balloon"></div>
    </div>

</div>

<!-- BACK BUTTON -->
<a href="../index.html" class="back-btn" id="backBtn">BACK ◀</a>

<script>

/* BANNER TEXT */
const text = "❤️ HAPPY BIRTHDAY VAISIYAA ❤️";
const banner = document.getElementById("banner");

text.split("").forEach((char, i) => {
    if (char === " ") {
        const space = document.createElement("div");
        space.style.width = "8px";
        banner.appendChild(space);
        return;
    }

    const div = document.createElement("div");
    div.className = "letter";
    div.textContent = char;
    div.style.animationDelay = (i * 0.1) + "s";

    banner.appendChild(div);
});

/* REVEAL FUNCTION */
document.getElementById("revealBtn").onclick = function() {

    document.body.classList.remove("start-screen");
    document.body.classList.add("main-screen");

    document.getElementById("startContent").style.display = "none";
    document.getElementById("mainContent").style.display = "block";

    document.getElementById("banner").style.display = "flex";
    document.querySelector(".balloons").style.display = "flex";

    /* SHOW BACK BUTTON AFTER REVEAL */
    document.getElementById("backBtn").style.display = "block";
};

</script>

</body>
</html>
